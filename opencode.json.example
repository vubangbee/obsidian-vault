{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "obsidian-mcp-server"],
      "environment": {
        "OBSIDIAN_API_KEY": "KEY_TU_LOCAL_REST_API_CUA_BAN",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_VERIFY_SSL": "false"
      },
      "enabled": true
    }
  }
}
